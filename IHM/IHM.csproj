<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IHM_essai</RootNamespace>
    <!-- Supprime le warning de conflit WindowsBase v4 vs v5 -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3800.47" />
    <PackageReference Include="MQTTnet" Version="5.1.0.1559" />
  </ItemGroup>

  <!-- Force la résolution du conflit WindowsBase en faveur de la version net8 -->
  <ItemGroup>
    <Reference Include="WindowsBase">
      <HintPath>$(MSBuildProgramFiles32)\dotnet\packs\Microsoft.NETCore.App.Ref\8.0.23\ref\net8.0\WindowsBase.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
